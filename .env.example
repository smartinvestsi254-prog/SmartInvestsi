# Database
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Node Environment
NODE_ENV="development"

# Server
PORT=3000
ALLOWED_ORIGINS="http://localhost:3000,https://smartinvestsi.netlify.app"

# JWT Secrets
JWT_SECRET_CURRENT="your-super-secret-jwt-key-change-this"
JWT_SECRET_PREVIOUS="your-previous-jwt-key-for-rotation"
JWT_REFRESH_SECRET_CURRENT="your-refresh-secret-key"
JWT_REFRESH_SECRET_PREVIOUS="your-previous-refresh-secret"

# Payment Services
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Sentry
SENTRY_DSN=""

# Admin
ADMIN_EMAIL="your_admin_email"
ADMIN_ACCOUNT_ID="your_admin_account_id"
