// ===========================================
// GENERATOR & DATASOURCE
// Database: PostgreSQL on Supabase
// ===========================================

generator client {
  provider  = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  // Use env-provided DATABASE_URL for application connections
  // and DIRECT_URL for migrations/direct connections. This allows
  // prisma generate/migrate to run in CI using environment variables.
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================
// USER MANAGEMENT (Minimal - shared auth)
// ===========================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  passwordHash     String?   @db.VarChar(255)
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  isBanned         Boolean   @default(false)
  role             UserRole  @default(VIEWER)
  subscriptionTier String    @default("FREE")
  phone            String?
  country          String?
  bankName         String?
  accountNumber    String?
  acceptTerms      DateTime?
  resetToken       String?   @unique
  resetExpires     DateTime?
  confirmToken     String?   @unique
  confirmExpires   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile             UserProfile?
  payments            Payment[]
  notifications       Notification[]
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
  ANALYST
  INCIDENT_COMMANDER
  VIEWER
}

// User Profile for Investment Dashboard Personalization
model UserProfile {
  id                String    @id @default(uuid())
  user              User?     @relation(fields: [userId], references: [id])
  userId            String?   @unique
  email             String    @unique
  investmentGoal    String?
  timeHorizon       String?
  riskTolerance     String?
  preferredRegion   String?
  portfolioValue    Float?
  monthlyIncome     Float?
  preferences       Json?
  premiumAccess     Boolean   @default(false)
  premiumExpiry     DateTime?
  lastUpdated       DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

// ===========================================
// APPLICATION SETTINGS
// ===========================================

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===========================================
// SUBSCRIPTION & TIER MANAGEMENT
// ===========================================

model SubscriptionTier {
  id                String   @id @default(uuid())
  name              String   @unique
  displayName       String
  monthlyPrice      Float
  annualPrice       Float
  description       String?
  features          Json
  limits            Json
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions     Subscription[]
  @@map("subscription_tiers")
}

model Subscription {
  id                String           @id @default(uuid())
  userEmail         String
  tierId            String
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime         @default(now())
  endDate           DateTime?
  autoRenew         Boolean          @default(false)
  paymentMethod     String?
  lastPaymentDate   DateTime?
  nextBillingDate   DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tier              SubscriptionTier @relation(fields: [tierId], references: [id])
  transactions      SubscriptionTransaction[]

  @@unique([userEmail, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

model SubscriptionTransaction {
  id              String   @id @default(uuid())
  subscriptionId  String
  amount          Float
  currency        String   @default("USD")
  status          String
  paymentMethod   String
  transactionId   String?
  metadata        Json?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  @@map("subscription_transactions")
}

// ===========================================
// PORTFOLIO MANAGEMENT
// ===========================================

model Portfolio {
  id                String   @id @default(uuid())
  userEmail         String
  name              String
  description       String?
  currency          String   @default("USD")
  totalValue        Float    @default(0)
  cashBalance       Float    @default(0)
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  targetAllocation  Json?
  rebalanceSettings Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  holdings          Holding[]
  transactions      Transaction[]
  performances      PortfolioPerformance[]
  rebalances        Rebalance[]

  @@index([userEmail])
  @@map("portfolios")
}

model Holding {
  id                String   @id @default(uuid())
  portfolioId       String
  symbol            String
  assetType         AssetType
  quantity          Float
  averageCost       Float
  currentPrice      Float    @default(0)
  marketValue       Float    @default(0)
  costBasis         Float    @default(0)
  unrealizedGain    Float    @default(0)
  unrealizedGainPct Float    @default(0)
  allocation        Float    @default(0)
  lastPriceUpdate   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  dividends         Dividend[]

  @@index([portfolioId, symbol])
  @@map("holdings")
}

enum AssetType {
  STOCK
  ETF
  MUTUAL_FUND
  BOND
  CRYPTO
  REIT
  COMMODITY
  CASH
  OTHER
}

model Transaction {
  id                String          @id @default(uuid())
  portfolioId       String
  symbol            String
  type              TransactionType
  quantity          Float
  price             Float
  fees              Float           @default(0)
  adminFee          Float           @default(0)
  totalAmount       Float
  notes             String?
  executedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())

  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, executedAt])
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
  FEE
  TRANSFER_IN
  TRANSFER_OUT
}

model PortfolioPerformance {
  id                String   @id @default(uuid())
  portfolioId       String
  date              DateTime
  totalValue        Float
  cashBalance       Float
  investedAmount    Float
  gainLoss          Float
  gainLossPct       Float
  dailyReturn       Float?
  createdAt         DateTime @default(now())

  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, date])
  @@map("portfolio_performances")
}

model Rebalance {
  id                String          @id @default(uuid())
  portfolioId       String
  status            RebalanceStatus @default(PROPOSED)
  proposedTrades    Json
  executedTrades    Json?
  reason            String?
  proposedAt        DateTime        @default(now())
  executedAt        DateTime?
  createdAt         DateTime        @default(now())

  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  @@map("rebalances")
}

enum RebalanceStatus {
  PROPOSED
  APPROVED
  EXECUTED
  REJECTED
  CANCELLED
}

model Dividend {
  id                String   @id @default(uuid())
  holdingId         String
  symbol            String
  amount            Float
  currency          String   @default("USD")
  exDate            DateTime
  paymentDate       DateTime
  declaredDate      DateTime?
  frequency         String?
  isReinvested      Boolean  @default(false)
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  holding           Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([symbol, exDate])
  @@map("dividends")
}

// ===========================================
// PRICE ALERTS
// ===========================================

model PriceAlert {
  id                String      @id @default(uuid())
  userEmail         String
  symbol            String
  targetPrice       Float
  condition         AlertCondition
  isActive          Boolean     @default(true)
  isTriggered       Boolean     @default(false)
  notifyEmail       Boolean     @default(true)
  notifySMS         Boolean     @default(false)
  notifyApp         Boolean     @default(true)
  triggeredAt       DateTime?
  triggeredPrice    Float?
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  notifications     AlertNotification[]

  @@index([userEmail, isActive])
  @@index([symbol, isActive])
  @@map("price_alerts")
}

enum AlertCondition {
  ABOVE
  BELOW
  CROSSES
  PERCENT_CHANGE
}

model AlertNotification {
  id                String   @id @default(uuid())
  alertId           String
  channel           String
  sentAt            DateTime @default(now())
  status            String
  errorMessage      String?

  alert             PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  @@map("alert_notifications")
}

// ===========================================
// MULTI-CURRENCY WALLETS
// ===========================================

model Wallet {
  id                String   @id @default(uuid())
  userEmail         String
  currency          String
  balance           Float    @default(0)
  availableBalance  Float    @default(0)
  heldBalance       Float    @default(0)
  adminFeesPaid     Float    @default(0)
  isPrimary         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      WalletTransaction[]

  @@unique([userEmail, currency])
  @@index([userEmail])
  @@map("wallets")
}

model WalletTransaction {
  id                String   @id @default(uuid())
  walletId          String
  type              WalletTransactionType
  amount            Float
  adminFee          Float    @default(0)
  balanceBefore     Float
  balanceAfter      Float
  currency          String
  description       String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime @default(now())

  wallet            Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  EXCHANGE
  FEE
  REFUND
  DIVIDEND
  INTEREST
}

model CurrencyExchange {
  id                String   @id @default(uuid())
  userEmail         String
  fromCurrency      String
  toCurrency        String
  fromAmount        Float
  toAmount          Float
  exchangeRate      Float
  fee               Float    @default(0)
  status            String   @default("COMPLETED")
  executedAt        DateTime @default(now())

  @@index([userEmail, executedAt])
}

// ===========================================
// BANK LINKING
// ===========================================

model BankAccount {
  id                String   @id @default(uuid())
  userEmail         String
  bankName          String
  accountNumber     String
  accountType       String
  currency          String   @default("USD")
  isVerified        Boolean  @default(false)
  isPrimary         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transfers         BankTransfer[]
  autoInvest        AutoInvestment?

  @@index([userEmail])
  @@map("bank_accounts")
}

model BankTransfer {
  id                String   @id @default(uuid())
  bankAccountId     String
  walletId          String?
  type              String
  amount            Float
  adminFee          Float @default(0)
  currency          String
  status            TransferStatus @default(PENDING)
  scheduledAt       DateTime?
  initiatedAt       DateTime @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  externalId        String?
  metadata          Json?

  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, initiatedAt])
  @@map("bank_transfers")
}
