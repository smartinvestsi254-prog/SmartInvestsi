{
  "name": "smartinvestsi-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "SmartInvestsi Monorepo — SmartInvestsi (Fintech) + SmartGovern (Governance) + shared packages",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspaces --if-present --include-workspace-root=false --prefix packages",
    "build:apps": "npm run build --workspaces --if-present --include-workspace-root=false --prefix apps",
    "build:smartinvestsi": "npm run build -w apps/smartinvestsi",
    "build:smartgovern": "npm run build -w apps/smartgovern",
    "dev": "concurrently -n smartinvestsi,smartgovern -c cyan,magenta \"npm run dev:smartinvestsi\" \"npm run dev:smartgovern\"",
    "dev:smartinvestsi": "npm run dev -w apps/smartinvestsi",
    "dev:smartgovern": "npm run dev -w apps/smartgovern",
    "start:smartinvestsi": "npm run start -w apps/smartinvestsi",
    "start:smartgovern": "npm run start -w apps/smartgovern",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "eslint \"{apps,packages}/**/*.{ts,js}\"",
    "lint:fix": "eslint \"{apps,packages}/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,js,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w apps/smartinvestsi && npm run prisma:generate -w apps/smartgovern",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w apps/smartinvestsi && npm run prisma:migrate:dev -w apps/smartgovern",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w apps/smartinvestsi && npm run prisma:migrate:deploy -w apps/smartgovern",
    "prisma:studio": "npm run prisma:studio -w apps/smartinvestsi",
    "inject:env": "node scripts/inject-public-env.js",
    "validate": "npm run lint && npm run type-check && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^2.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.7.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "projects": [
      "<rootDir>/apps/*",
      "<rootDir>/packages/*"
    ]
  }
}

