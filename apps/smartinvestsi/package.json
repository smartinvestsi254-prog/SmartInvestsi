{
  "name": "@smartinvestsi/app",
  "version": "1.0.0",
  "private": true,
  "description": "SmartInvestsi - Fintech Investment Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=../../prisma/schemas/smartinvestsi.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=../../prisma/schemas/smartinvestsi.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=../../prisma/schemas/smartinvestsi.prisma",
    "prisma:studio": "prisma studio --schema=../../prisma/schemas/smartinvestsi.prisma"
  },
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "@smartinvest/shared-security": "workspace:*",
    "@smartinvest/shared-types": "workspace:*",
    "@smartinvest/shared-utils": "workspace:*",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^8.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^6.4.14",
    "tsx": "^4.7.2",
    "typescript": "^5.6.3"
  }
}

